# TRUE CUTOUT — Environment Variables
# Copy this file to .env.local and fill in your credentials.

# AI Background Removal Provider
# The API key for your background-removal provider (e.g., remove.bg, Clipdrop, Replicate)
BACKGROUND_REMOVAL_API_KEY=

# The base URL for the provider API (optional — defaults to remove.bg)
BACKGROUND_REMOVAL_API_URL=

# Provider type: "removebg" | "clipdrop" | "replicate"
BACKGROUND_REMOVAL_PROVIDER=removebg

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Maximum image dimension in pixels (default: 4096)
MAX_IMAGE_DIMENSION=4096
